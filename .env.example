# Access Token de Mercado Pago.
# Test:    se genera en https://www.mercadopago.com.ar/developers/panel/test
# Produccion: https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=""

# Secreto de firma para validar los webhooks.
# Mercado Pago -> Tu aplicacion -> "Tus Integraciones" -> copiar "Secreto Firma".
# Si lo dejas vacio el webhook responde 401 y los pagos no se registran.
MP_WEBHOOK_SECRET=""

# URL publica del sitio, sin slash final.
# En produccion tiene que ser https, Mercado Pago rechaza http:// y localhost.
SITE_URL="http://localhost:3000"

# Solo para pruebas. Email del usuario de prueba que compra en el checkout.
# En sandbox el comprador tiene que ser un usuario de prueba (@testuser.com):
# si se escribe un email real, MP rechaza la operacion al confirmar con
# "una de las partes es de prueba". Vaciarlo en produccion.
MP_TEST_PAYER_EMAIL=""

# API Key de Resend para enviar el ebook por email.
# Se genera en https://resend.com/api-keys
RESEND_API_KEY=""

# Email remitente (verificado en Resend). Debe coincidir con el dominio conectado.
RESEND_FROM_EMAIL="onboarding@resend.dev"